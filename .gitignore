.backup/
*.bak
.idea/
.vscode/
*.iml
*~

# ---------- WorkBuddy 本地数据 ----------
# 如希望把 .workbuddy/memory 里的开发记录一起入库，删掉下面这一行
.workbuddy/

# ---------- Xcode 构建产物 ----------
build/
DerivedData/
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip
*.hmap
*.moved-aside
*.o
*.swiftpm
.swiftpm/
SourcePackages/
.build/

# ---------- Xcode 用户级文件 ----------
# xcuserdata 存的是本机的窗口状态、断点、选中设备，换台机器就是噪音
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

